# ── Zarina Hotels — Environment Configuration ──
# Copy to .env and fill values. NEVER commit real secrets.

# Database (Neon / any managed PostgreSQL; sqlite allowed for local dev only)
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://user:password@host:5432/zarina?schema=public"

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_NAME="Zarina Hotels"

# Admin bootstrap (first admin only — created via: npm run admin:create)
ADMIN_BOOTSTRAP_EMAIL="owner@zarinahotels.com"
ADMIN_BOOTSTRAP_NAME="Owner"
# One-time setup: visit /admin/setup?token=... printed by the CLI

# Payment provider: MOCK | BOG | TBC
PAYMENT_PROVIDER="MOCK"
# Bank of Georgia (fill when account is opened)
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
BOG_CALLBACK_URL="https://yourdomain.com/api/payments/bog/callback"
# TBC
TBC_CLIENT_ID=""
TBC_CLIENT_SECRET=""

# Email: RESEND | SMTP | MOCK
EMAIL_PROVIDER="MOCK"
RESEND_API_KEY=""
EMAIL_FROM="Zarina Hotels <bookings@zarinahotels.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Currency rates source (server-side only)
CURRENCY_API_URL="https://open.er-api.com/v6/latest/GEL"

# Security
SESSION_SECRET="generate-a-64-char-random-string-here"
CRON_SECRET="generate-random-string-for-cron-endpoints"

# Analytics (placeholders; loaded only after cookie consent)
NEXT_PUBLIC_GA_ID=""
